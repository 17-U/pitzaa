# ---------------------------------------------------------------------------
# Pitzaa — variables d'environnement de PRODUCTION (modèle). Copiez en .env sur
# le VPS et complétez — ne jamais committer le fichier .env réel.
#
# Différences avec .env.example (dev) :
#   - DATABASE_URL/REDIS_URL pointent vers les noms de service Docker
#     (postgres, redis), pas localhost, et sur leurs ports internes standards.
#   - Tous les secrets (JWT, VAULT_ENCRYPTION_KEY, mots de passe) doivent être
#     régénérés — ne jamais réutiliser les valeurs de développement.
# ---------------------------------------------------------------------------

NODE_ENV=production
TZ=UTC
APP_DISPLAY_TZ=Africa/Douala
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en

# API
API_PORT=3000

# Base de données (PostgreSQL) — nom de service Docker, port interne standard.
POSTGRES_USER=pitzaa
POSTGRES_PASSWORD=__GENERER_UN_MOT_DE_PASSE_FORT__
POSTGRES_DB=pitzaa
DATABASE_URL=postgresql://pitzaa:__GENERER_UN_MOT_DE_PASSE_FORT__@postgres:5432/pitzaa?schema=public

# Redis / BullMQ — nom de service Docker.
REDIS_URL=redis://redis:6379

# Auth — générer avec `openssl rand -hex 32` (deux valeurs distinctes).
JWT_ACCESS_SECRET=__GENERER_openssl_rand_-hex_32__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__GENERER_openssl_rand_-hex_32__
JWT_REFRESH_EXPIRES_IN=30d

# Chiffrement du coffre-fort d'identifiants (AES-256-GCM, 32 octets en hexadécimal
# = `openssl rand -hex 32`). Ne JAMAIS faire tourner cette clé une fois des
# données chiffrées en base : elles deviendraient indéchiffrables. La sauvegarder
# hors du serveur (gestionnaire de secrets, coffre-fort séparé du dépôt).
VAULT_ENCRYPTION_KEY=__GENERER_openssl_rand_-hex_32__

# SMS / OTP — mock en attendant un fournisseur réel (voir QUESTIONS.md).
SMS_PROVIDER=mock
SMS_SENDER_ID=PITZAA

# Paiements mobile money — mock en attendant Fapshi/KPay (voir QUESTIONS.md).
PAYMENT_PROVIDER=mock
PAYMENT_PRIMARY_PROVIDER=fapshi
PAYMENT_FALLBACK_PROVIDER=kpay
MOCK_WEBHOOK_SECRET=__GENERER_openssl_rand_-hex_32__

# Nom d'hôte public de l'API, utilisé par Caddy pour le certificat TLS automatique
# (Let's Encrypt). Sans nom de domaine, utiliser <ip-du-vps-avec-tirets>.nip.io,
# ex: 203-0-113-25.nip.io pour l'IP 203.0.113.25.
API_DOMAIN=

# Origines autorisées à appeler l'API (CORS), séparées par des virgules —
# l'URL du déploiement Vercel du front. Vide = tout autorisé (ne pas laisser
# vide en production).
CORS_ORIGIN=https://votre-app.vercel.app
